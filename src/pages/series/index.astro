---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContentCard from '../../components/ContentCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import WikiLayout from '../../layouts/WikiLayout.astro';
import { fetchContent } from '../../lib/content';
import { seriesListQuery } from '../../lib/sanity/queries';
import type { ContentSummary } from '../../lib/sanity/types';

type SeriesSummary = ContentSummary & { publishedArticleCount: number };
const series = await fetchContent<SeriesSummary[]>(seriesListQuery);
---

<WikiLayout title="Series & Learning Paths" description="Ordered learning paths through related technical articles by Eiakoji." currentSlug="series">
  <div class="series-index-page">
    <Breadcrumbs items={[{ label: 'Series & Learning Paths' }]} />
    <header class="page-heading">
      <p class="eyebrow">Follow the thread</p>
      <h1>Series & Learning Paths</h1>
      <p>Curated curriculums for complex subjects that need more than one article to explain thoroughly.</p>
    </header>
    <section class="section" aria-label="Published series">
      {series.length > 0 ? (
        <div class="card-grid">
          {series.map((item) => (
            <ContentCard item={item} articleCount={item.publishedArticleCount} />
          ))}
        </div>
      ) : (
        <EmptyState
          title="No published series yet"
          message="A series will appear here once it has been created in Sanity."
        />
      )}
    </section>
  </div>
</WikiLayout>
