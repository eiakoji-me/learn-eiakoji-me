---
const pathname = Astro.url.pathname;
const links = [
  { href: '/topics/system-design/', label: 'System Design' },
  { href: '/topics/platform-engineering/', label: 'Platform Engineering' },
  { href: '/topics/ai-engineering/', label: 'AI Engineering' },
  { href: '/workshops/', label: 'Workshops' },
  { href: '/projects/', label: 'Projects' },
];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="wiki.eiakoji.me home">
      <img class="brand-avatar" src="/images/avatar.jpeg" alt="" width="34" height="34" />
      <span>wiki.eiakoji.me</span>
    </a>
    <nav aria-label="Primary navigation">
      <ul>
        {links.map(({ href, label }) => (
          <li><a href={href} aria-current={pathname.startsWith(href) ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
