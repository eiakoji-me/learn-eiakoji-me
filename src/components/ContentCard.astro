---
import { contentHref, formatDate } from '../lib/content';
import { imageUrl } from '../lib/sanity/image';
import type { ContentSummary } from '../lib/sanity/types';

interface Props {
  item: ContentSummary;
  articleCount?: number;
}

const { item, articleCount } = Astro.props;

const formatLabels: Record<string, string> = {
  article: 'Article',
  'deep-dive': 'Deep Dive',
  tutorial: 'Tutorial',
  workshop: 'Workshop',
  'case-study': 'Case Study',
  showcase: 'Showcase',
  'reading-note': 'Reading Note',
  'reading-notes': 'Reading Note',
  reference: 'Reference',
};

const activeFormat = item.format || item.kind;
const label = item._type === 'series'
  ? 'Series'
  : item._type === 'project'
    ? 'Case Study'
    : (activeFormat && formatLabels[activeFormat]) || 'Article';

const href = contentHref(item._type, item.slug);
---

<article class="content-card">
  <a class="card-link" href={href} aria-label={`Read ${item.title}`}>
    {item.featuredImage?.asset ? (
      <img
        class="card-image"
        src={imageUrl(item.featuredImage.asset, 900)}
        alt={item.featuredImage.alt}
        loading="lazy"
        width="900"
        height="506"
      />
    ) : (
      <div class="card-placeholder" aria-hidden="true"><span>{label.slice(0, 1)}</span></div>
    )}
    <div class="card-body">
      <div class="card-meta">
        {item.primaryTopic && <span class="card-domain">{item.primaryTopic.title}</span>}
        <span class="card-format">{label}</span>
        {item.publishedAt && <time datetime={item.publishedAt}>{formatDate(item.publishedAt)}</time>}
        {typeof articleCount === 'number' && <span>{articleCount} {articleCount === 1 ? 'article' : 'articles'}</span>}
      </div>
      <h2>{item.title}</h2>
      <p>{item.summary}</p>
      {item.relatedTopics && item.relatedTopics.length > 0 && (
        <ul class="card-topics" aria-label="Topics">
          {item.relatedTopics.slice(0, 3).map((topic) => (
            <li>{topic.title}</li>
          ))}
        </ul>
      )}
      <span class="card-action">Explore <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>
