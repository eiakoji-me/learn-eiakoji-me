---
import TableOfContents from './TableOfContents.astro';
import type { HeadingItem } from '../lib/slugify';
import type { Article } from '../lib/sanity/types';

interface Props {
  headings?: HeadingItem[];
  article?: Article;
}

const { headings = [], article } = Astro.props;
const hasActions = Boolean(article?.repositoryUrl || article?.demoUrl);
const hasSeries = Boolean(article?.series && article.series.articles && article.series.articles.length > 0);

let currentSeriesIndex = -1;
let prevSeriesArticle = null;
let nextSeriesArticle = null;

if (hasSeries && article?.series?.articles) {
  currentSeriesIndex = article.series.articles.findIndex((a) => a.slug === article.slug);
  if (currentSeriesIndex > 0) {
    prevSeriesArticle = article.series.articles[currentSeriesIndex - 1];
  }
  if (currentSeriesIndex >= 0 && currentSeriesIndex < article.series.articles.length - 1) {
    nextSeriesArticle = article.series.articles[currentSeriesIndex + 1];
  }
}
---

<aside class="wiki-right-rail" aria-label="Article outline and context">
  {headings.length > 0 && <TableOfContents headings={headings} />}

  {hasActions && (
    <div class="rail-card actions-card">
      <div class="rail-header">Resources</div>
      <div class="action-buttons">
        {article?.repositoryUrl && (
          <a href={article.repositoryUrl} target="_blank" rel="noopener noreferrer" class="action-btn repo-btn">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
            <span>GitHub Repository</span>
          </a>
        )}
        {article?.demoUrl && (
          <a href={article.demoUrl} target="_blank" rel="noopener noreferrer" class="action-btn demo-btn">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
              <path d="M4.75 3a.75.75 0 000 1.5h6.5a.75.75 0 000-1.5h-6.5zM3 6.75A.75.75 0 013.75 6h8.5a.75.75 0 010 1.5h-8.5A.75.75 0 013 6.75zM3.75 9a.75.75 0 000 1.5h4.5a.75.75 0 000-1.5h-4.5z"/>
            </svg>
            <span>Live Showcase</span>
          </a>
        )}
      </div>
    </div>
  )}

  {hasSeries && article?.series && (
    <div class="rail-card series-card">
      <div class="rail-header">Learning Path</div>
      <a href={`/series/${article.series.slug}/`} class="series-title">{article.series.title}</a>
      <p class="series-progress">
        Part {currentSeriesIndex + 1} of {article.series.articles!.length}
      </p>
      <div class="series-nav-links">
        {prevSeriesArticle && (
          <a href={`/articles/${prevSeriesArticle.slug}/`} class="series-prev">
            <span class="nav-dir">← Previous</span>
            <span class="nav-label">{prevSeriesArticle.title}</span>
          </a>
        )}
        {nextSeriesArticle && (
          <a href={`/articles/${nextSeriesArticle.slug}/`} class="series-next">
            <span class="nav-dir">Next →</span>
            <span class="nav-label">{nextSeriesArticle.title}</span>
          </a>
        )}
      </div>
    </div>
  )}

  {article?.primaryTopic && (
    <div class="rail-card topic-card">
      <div class="rail-header">Topic Hub</div>
      <a href={`/topics/${article.primaryTopic.slug}/`} class="topic-link">
        <span>Explore {article.primaryTopic.title}</span>
        <span aria-hidden="true">→</span>
      </a>
      {article.relatedTopics && article.relatedTopics.length > 0 && (
        <div class="related-topics">
          <span class="related-label">Related:</span>
          {article.relatedTopics.map((t) => (
            <a href={`/topics/${t.slug}/`} class="related-tag">{t.title}</a>
          ))}
        </div>
      )}
    </div>
  )}
</aside>

<style>
  .wiki-right-rail {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    font-size: 0.85rem;
  }
  .rail-card {
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .rail-header {
    margin-bottom: 10px;
    font-size: 0.72rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .action-buttons {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--forest);
    font-weight: 650;
    font-size: 0.82rem;
    text-decoration: none;
    transition: background 140ms ease, border-color 140ms ease;
  }
  .action-btn:hover {
    background: var(--mint);
    border-color: var(--forest);
  }
  .series-title {
    display: block;
    font-weight: 700;
    color: var(--forest);
    text-decoration: none;
    margin-bottom: 4px;
  }
  .series-title:hover {
    text-decoration: underline;
  }
  .series-progress {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 0.78rem;
  }
  .series-nav-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid var(--line);
    padding-top: 10px;
  }
  .series-prev, .series-next {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    font-size: 0.8rem;
  }
  .nav-dir {
    font-size: 0.72rem;
    color: var(--accent-dark);
    font-weight: 700;
  }
  .nav-label {
    color: var(--ink);
    line-height: 1.3;
  }
  .series-prev:hover .nav-label, .series-next:hover .nav-label {
    text-decoration: underline;
  }
  .topic-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 700;
    color: var(--forest);
    text-decoration: none;
  }
  .topic-link:hover {
    text-decoration: underline;
  }
  .related-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px dashed var(--line);
  }
  .related-label {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .related-tag {
    font-size: 0.75rem;
    padding: 2px 6px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--forest);
    text-decoration: none;
  }
  .related-tag:hover {
    border-color: var(--accent);
  }
</style>
